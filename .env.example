# Copy to .env and adjust. .env is gitignored.

# Used by docker-compose.yml
POSTGRES_USER=keel
POSTGRES_PASSWORD=keel
POSTGRES_DB=keel
POSTGRES_PORT=5432
REDIS_PORT=6379

# Used by keel and the integration tests. Integration tests are skipped when unset.
KEEL_DATABASE_URL=postgresql://keel:keel@localhost:5432/keel
KEEL_REDIS_URL=redis://localhost:6379/0
